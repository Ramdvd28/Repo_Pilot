# Server Configuration
PROJECT_NAME="RepoPilot AI"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Local Development: Docker PostgreSQL or SQLite fallback in storage/repopilot.db
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=repopilot_db
DATABASE_URL=postgresql+asyncpg://repopilot:repopilot_password@localhost:5432/repopilot_db

# Vercel Serverless Deployment Requirement:
# On Vercel, serverless function containers are ephemeral and isolated.
# A persistent managed PostgreSQL database (e.g. Neon, Supabase, Vercel Postgres, AWS RDS)
# MUST be configured via DATABASE_URL or POSTGRES_URL in Vercel Project Settings > Environment Variables
# so that repository metadata, indexed code chunks, and chat sessions persist across separate function instances and cold starts.
#
# Examples:
# Neon / Supabase:
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or Vercel Postgres automatic environment variable:
# POSTGRES_URL=postgres://default:password@ep-sample-pooler.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require

# GitHub API Integration
# Optional: GitHub Personal Access Token to avoid GitHub API rate limits (60 req/hr unauthenticated vs 5000 req/hr authenticated)
GITHUB_TOKEN=

# AI Provider Configuration
# Supported providers: "openai", "gemini"
AI_PROVIDER=openai

# OpenAI API Key (required if AI_PROVIDER=openai)
OPENAI_API_KEY= 

# Gemini API Key (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Embedding Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
